# SPA fallback for Euro India Foods — serve index.html for client-side routes
# while letting real files (assets, /api/*.php, pdfs, favicons) resolve directly.

# Prevent ERR_HTTP2_PROTOCOL_ERROR on large images: do NOT gzip already-compressed
# binary assets. mod_deflate is often enabled globally on cPanel/Apache hosts and
# corrupts HTTP/2 framing when it tries to compress large PNG/JPEG/WebP files.
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.(?:png|jpe?g|gif|webp|avif|ico|svgz|woff2?|ttf|otf|eot|pdf)$ no-gzip dont-vary
  # Compress text-based assets (these compress well and are safe over HTTP/2).
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Send correct Content-Type values even on cPanel installations with an older
# shared MIME database.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# Give stable public files a short freshness window. Fingerprinted files under
# /assets/ and /image-assets/ receive the immutable policy below.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/gif "access plus 1 day"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/avif "access plus 1 day"
  ExpiresByType image/x-icon "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 day"
  ExpiresByType application/font-woff "access plus 1 day"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "/(?:assets|image-assets)/" fingerprinted_asset=1
</IfModule>

<IfModule mod_headers.c>
  # Stable filenames can change between deploys, so keep revalidation enabled.
  <FilesMatch "\.(?:js|css|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|pdf)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800" env=!fingerprinted_asset
  </FilesMatch>

  # Vite and the image pipeline put content hashes in these directory trees.
  Header set Cache-Control "public, max-age=31536000, immutable" env=fingerprinted_asset

  # HTML must always revalidate so new deploys are served.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and directories as-is (JS/CSS chunks, images, /api PHP, PDFs, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never rewrite the /api PHP handlers — they must execute as PHP.
  RewriteRule ^api/ - [L]

  # Everything else (e.g. /contact, /dealers, /chips) → SPA entry point.
  RewriteRule ^ index.html [L]
</IfModule>
